{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crowsi://control/enforcement-receipt/v2",
  "title": "Crowsi Enforcement Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "receipt_id", "command_jti", "command_digest",
    "security_domain", "deployment_id", "incident_id", "target_id",
    "release_reservation_id", "fence_epoch", "binding", "provider",
    "outcome", "authorization_consumed", "applied_at",
    "expected_resource_version", "resulting_resource_version",
    "residual_exposures", "evidence_digest", "signed"
  ],
  "properties": {
    "schema": { "const": "crowsi://control/enforcement-receipt/v2" },
    "receipt_id": { "$ref": "#/$defs/identifier" },
    "command_jti": { "$ref": "#/$defs/identifier" },
    "command_digest": { "$ref": "#/$defs/digest" },
    "security_domain": { "$ref": "#/$defs/identifier" },
    "deployment_id": { "$ref": "#/$defs/identifier" },
    "incident_id": { "$ref": "#/$defs/identifier" },
    "target_id": { "$ref": "#/$defs/opaque" },
    "release_reservation_id": { "$ref": "#/$defs/identifier" },
    "fence_epoch": { "type": "integer", "minimum": 1 },
    "binding": { "$ref": "#/$defs/binding" },
    "provider": { "$ref": "#/$defs/identifier" },
    "outcome": { "enum": ["applied", "rejected", "failed", "partial"] },
    "authorization_consumed": { "const": true },
    "applied_at": { "$ref": "#/$defs/timestamp" },
    "expected_resource_version": { "$ref": "#/$defs/opaque" },
    "resulting_resource_version": {
      "oneOf": [{ "$ref": "#/$defs/opaque" }, { "type": "null" }]
    },
    "residual_exposures": {
      "type": "array", "maxItems": 32,
      "items": { "$ref": "#/$defs/opaque" }
    },
    "evidence_digest": { "$ref": "#/$defs/digest" },
    "signed": { "$ref": "#/$defs/signed" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "applied" } } },
      "then": {
        "properties": {
          "resulting_resource_version": { "$ref": "#/$defs/opaque" },
          "residual_exposures": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "partial" } } },
      "then": {
        "properties": { "residual_exposures": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "opaque": { "type": "string", "minLength": 1, "maxLength": 256 },
    "digest": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "resource", "action", "purpose", "channel"],
      "properties": {
        "audience": { "$ref": "#/$defs/identifier" },
        "resource": { "$ref": "#/$defs/opaque" },
        "action": {
          "enum": ["quarantine", "restrict-egress", "revoke-access", "restore"]
        },
        "purpose": { "$ref": "#/$defs/identifier" },
        "channel": {
          "enum": ["hatter-interactive", "emergency-console", "service-automation"]
        }
      }
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "digest", "signature"],
      "properties": {
        "algorithm": { "enum": ["ed25519", "ecdsa-p256-sha256"] },
        "key_id": { "$ref": "#/$defs/identifier" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": {
          "type": "string", "pattern": "^[A-Za-z0-9_-]{43,2048}$"
        }
      }
    }
  }
}
